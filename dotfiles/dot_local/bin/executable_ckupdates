#!/bin/sh

# Exit codes:
#   1: missing dependencies
#   2: internet failure
#   3: both repo and aur listing programs failed
#   4: partial success; either repo or aur listing program failed
#   5: invalid arguments

# saner programming env: these switches turn some bugs into errors
# dash doesn't support pipefail
set -o errexit -o noclobber -o nounset

err() {
    echo "${0##*/}: $@" >&2
}

network_check() {
    set +o errexit
    ping -c 1 -W 2 "$1" >/dev/null
    set -o errexit
}

is_installed() {
    if ! command -v "$1" >/dev/null; then
        err "\`$1\` not found"
        return 1
    fi
}

dependency_check() {
    if [ $# -eq 0 ]; then
        if is_installed checkupdates; then
            if ! command -v paru >/dev/null; then
                err "\`paru\` not found, aur updates will not be listed"
            fi
            return
        else
            exit 1
        fi
    fi

    case "$1" in
        '-a')
            should_exit=0
            is_installed checkupdates || should_exit=1
            if ! command -v paru >/dev/null; then
                err "\`paru\` not found, aur updates will not be listed"
            fi
            is_installed flatpak || should_exit=1
            [ $should_exit -eq 1 ] && exit 1
            ;;
        '-d')
            is_installed checkupdates || exit 1
            ;;
        '-f')
            is_installed flatpak || exit 1
            ;;
        *)
            err "invalid arguments"
            exit 5
            ;;
    esac
    return 0
}

# Early exit if we're missing programs.
dependency_check "$@"

if ! network_check asgard.jprice.uk \
    && ! network_check archlinux.org; then
    err "cannot reach internet"
    exit 2
fi

# Support downloading repo packages with the -d flag.
if [ $# -ge 1 ] && [ "$1" = '-d' ]; then
        checkupdates "$@"
        exit 0
fi

# Retrieve list of updates.
echo "Checking for updates..." >&2
if [ $# -eq 0 ] || [ "$1" = '-a' ]; then
    repo_updates="$(checkupdates)" || checkupdates_exit_code=$?

    if command -v paru >/dev/null; then
        aur_updates="$(paru --query --upgrades --aur --color=always)" || paru_exit_code=$?
        # If aur_updates is empty grep will fail. Just ignore it.
        aur_updates="$(printf "$aur_updates" | grep --invert-match '\[ignored\]' || :)"
    fi
fi

if [ $# -ge 1 ] && { [ "$1" = '-a' ] || [ "$1" = '-f' ]; }; then
    # Give flatpak a tty so it autoformats its output.
    flatpak_updates="$(script -qec "flatpak remote-ls --updates")" || flatpak_exit_code=$?
fi


# Deal with unpredicted failures.
if [ -n "${checkupdates_exit_code:-}" ] \
    && [ -n "${paru_exit_code:-}" ] \
    && [ -n "${flatpak_exit_code:-}" ]; then
    err "checkupdates, paru, and flatpak all unexpectedly failed"
    err "\`checkupdates\` exited with code: $checkupdates_exit_code"
    err "\`paru\` exited with code: $paru_exit_code"
    err "\`flatpak\` exited with code: $flatpak_exit_code"
    exit 3
elif [ -n "${checkupdates_exit_code:-}" ] && [ -n "${paru_exit_code:-}" ]; then
    err "\`checkupdates\` and \`paru\` unexpectedly failed"
    err "\`checkupdates\` exited with code: $checkupdates_exit_code"
    err "\`paru\` exited with code: $paru_exit_code"
    if [ $# -eq 0 ]; then
        exit 3
    elif [ "${1:-}" = '-a' ]; then
        err "only showing flatpak updates"
    fi
elif [ -n "${paru_exit_code:-}" ] && [ -n "${flatpak_exit_code:-}" ]; then
    err "\`paru\` and \`flatpak\` unexpectedly failed"
    err "\`paru\` exited with code: $paru_exit_code"
    err "\`flatpak\` exited with code: $flatpak_exit_code"
    err "only showing repo updates"
elif [ -n "${checkupdates_exit_code:-}" ] && [ -n "${flatpak_exit_code:-}" ]; then
    err "\`checkupdates\` and \`flatpak\` unexpectedly failed"
    err "\`checkupdates\` exited with code: $checkupdates_exit_code"
    err "\`flatpak\` exited with code: $flatpak_exit_code"
    err "only showing aur updates"
elif [ -n "${checkupdates_exit_code:-}" ]; then
    err "\`checkupdates\` unexpectedly failed with code: $checkupdates_exit_code"
    if [ $# -eq 0 ]; then
        err "only showing aur updates"
    elif [ "${1:-}" = '-a' ]; then
        err "only showing aur and flatpak updates"
    fi
elif [ -n "${paru_exit_code:-}" ]; then
    err "\`paru\` unexpectedly failed with code: $paru_exit_code"
    if [ $# -eq 0 ]; then
        err "only showing repo updates"
    elif [ "${1:-}" = '-a' ]; then
        err "only showing repo and flatpak updates"
    fi
elif [ -n "${flatpak_exit_code:-}" ]; then
    err "\`flatpak\` unexpectedly failed with code: $flatpak_exit_code"
    if [ "${1:-}" = '-f' ]; then
        exit 3
    elif [ "${1:-}" = '-a' ]; then
        err "only showing repo and aur updates"
    fi
fi


# Concatenate update sources
if [ -n "${repo_updates:-}" ] && [ -n "${aur_updates:-}" ]; then
    updates="$repo_updates
$aur_updates"
else
    updates="${repo_updates:-}${aur_updates:-}"
fi

if [ -n "$updates" ] && [ -n "${flatpak_updates:-}" ]; then
    updates="$updates

$flatpak_updates"
else
    updates="${updates:-}${flatpak_updates:-}"
fi


# Finally, print any updates.
if [ -z "$updates" ]; then
    echo "No updates. You're up to date!" >&2
else
    echo "$updates"
fi

if [ -n "${checkupdates_exit_code:-}" ] \
    || [ -n "${paru_exit_code:-}" ] \
    || [ -n "${flatpak_exit_code:-}" ]; then
    exit 4
fi

# vim: sw=4 sts=4 et
